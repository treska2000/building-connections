{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Connections-Bench Config v1",
  "type": "object",
  "required": ["config_id", "title", "specialty", "whitelist_sources", "axes", "terms"],
  "additionalProperties": true,
  "properties": {
    "config_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "specialty": {
      "type": "object",
      "required": ["field", "subfield", "area"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "subfield": {"type": "string", "minLength": 1},
        "area": {"type": "string", "minLength": 1}
      }
    },
    "whitelist_sources": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 3}
    },
    "axes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "description_en": {"type": "string"},
          "description_ru": {"type": "string"}
        }
      }
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "axes"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "description_en": {"type": "string"},
          "description_ru": {"type": "string"},
          "axes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "decoy_for_axes": {
            "type": "array",
            "items": {"type": "string"}
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["url"],
              "properties": {
                "url": {"type": "string", "format": "uri"},
                "title": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
